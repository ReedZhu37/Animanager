config_version=5

[application]
config/name="Animanager"
config/version="0.4.0"
run/main_scene="res://UI/MainShell.tscn"
run/low_processor_usage_mode=true
run/low_processor_usage_mode_sleep_usec=6900
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[autoload]
LimboConsole="*res://addons/limbo_console/limbo_console.gd"

[animanager]
development_library="res://Libraries/Nodachi-Motion"

[editor_plugins]
enabled=PackedStringArray("res://addons/limbo_console/plugin.cfg")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/subwindows/embed_subwindows=false

[dotnet]
project/assembly_name="Animanager"

[input]

limbo_console_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":96)]
}
limbo_auto_complete_reverse={
"deadzone": 0.5,
"events": [Object(InputEventKey,"shift_pressed":true,"keycode":4194306)]
}
limbo_console_search_history={
"deadzone": 0.5,
"events": [Object(InputEventKey,"ctrl_pressed":true,"keycode":82)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
